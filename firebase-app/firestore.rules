rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the user is an Admin
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Helper: Check if user has access to a project
    function hasProjectAccess(project) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.role == 'Admin' || (project in userData.access);
    }

    // Users collection
    match /users/{userId} {
      // Allow read for login mapping (username -> email)
      allow read: if true;
      // Allow authenticated users to write (admin check is done in application code)
      allow write: if true;
    }

    // Rooms collection (per project) - Legacy
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // BuildingRooms collection (Mega-Document)
    match /buildingRooms/{buildingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ProjectSummary collection
    match /projectSummary/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Room Statuses collection
    match /roomStatuses/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Layouts collection
    match /layouts/{layoutId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // BuildingStripes collection
    match /buildingStripes/{stripeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // CardGroups collection
    match /cardGroups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Summary Cards collection
    match /summaryCards/{cardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Logs collection
    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
